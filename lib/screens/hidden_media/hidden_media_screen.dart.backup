import 'dart:io';

import 'package:flutter/material.dart';
import 'package:permission_handler/permission_handler.dart';

import '../../models/media_file.dart';
import '../../services/recovery_service.dart';

class HiddenMediaScreen extends StatefulWidget {
  const HiddenMediaScreen({
    super.key,
  });

  @override
  State<HiddenMediaScreen> createState() =>
      _HiddenMediaScreenState();
}

class _HiddenMediaScreenState
    extends State<HiddenMediaScreen> {
  final RecoveryService _recovery =
      RecoveryService();

  final List<MediaFile> _hiddenMedia =
      <MediaFile>[];

  final Set<String> _hiddenFolders =
      <String>{};

  bool _isScanning = false;
  bool _isRecovering = false;

  int _imageCount = 0;
  int _videoCount = 0;
  int _documentCount = 0;

String _selectedFilter = 'All';

  @override
void initState() {
  super.initState();
}


  Future<bool> _requestStorageAccess() async {
  if (!Platform.isAndroid) {
    return true;
  }

  try {
    /*
     * Android 11+:
     * Direct filesystem scanning of shared storage requires
     * MANAGE_EXTERNAL_STORAGE.
     */

    final PermissionStatus manage =
        await Permission.manageExternalStorage.status;

    if (manage.isGranted) {
      return true;
    }

    /*
     * Open Android's "All files access" settings.
     */
    await Permission.manageExternalStorage.request();

    /*
     * Check again after returning from Android Settings.
     */
    final PermissionStatus manageAfter =
        await Permission.manageExternalStorage.status;

    if (manageAfter.isGranted) {
      return true;
    }

    /*
     * Fallback for older Android versions.
     */
    final PermissionStatus storage =
        await Permission.storage.status;

    if (storage.isGranted) {
      return true;
    }

    if (storage.isDenied ||
        storage.isRestricted) {
      final PermissionStatus storageAfter =
          await Permission.storage.request();

      if (storageAfter.isGranted) {
        return true;
      }
    }

    return false;
  } catch (e) {
    debugPrint(
      'Storage permission error: $e',
    );

    return false;
  }
}





  Future<void> _scanHiddenMedia() async {
    if (_isScanning) {
      return;
    }

    setState(() {
  _isScanning = true;
  _hiddenMedia.clear();
  _hiddenFolders.clear();
  _imageCount = 0;
  _videoCount = 0;
  _documentCount = 0;
});

    final bool access =
        await _requestStorageAccess();

    if (!access) {
      if (!mounted) {
        return;
      }

      setState(() {
        _isScanning = false;
      });

      _showStorageMessage();
      return;
    }

    try {
      final Directory root =
          Directory('/storage/emulated/0');

      if (!await root.exists()) {
        throw Exception(
          'Shared storage is not available.',
        );
      }

      await _scanDirectory(
        root,
        depth: 0,
        parentIsHidden: false,
      );

      if (!mounted) {
        return;
      }

      setState(() {
        _isScanning = false;
      });
    } catch (e) {
      if (!mounted) {
        return;
      }

      setState(() {
        _isScanning = false;
      });

      _showMessage(
        'Hidden scan failed: $e',
        isError: true,
      );
    }
  }

  Future<void> _scanDirectory(
    Directory directory, {
    required int depth,
    required bool parentIsHidden,
  }) async {
    /*
     * Limit recursion so one badly structured storage tree
     * cannot freeze the application.
     */
    if (depth > 8) {
      return;
    }

    final String path =
        directory.path.replaceAll('\\', '/');

    if (_shouldSkipDirectory(path)) {
      return;
    }

    bool containsNoMedia = false;
    bool directoryIsHidden =
        _isHiddenDirectory(directory);

    List<FileSystemEntity> children =
        <FileSystemEntity>[];

    try {
      children = await directory
          .list(
            followLinks: false,
          )
          .toList();
    } catch (_) {
      return;
    }

    /*
     * First pass:
     * detect .nomedia.
     */
    for (final FileSystemEntity entity
        in children) {
      if (entity is File) {
        final String name =
            _fileName(entity.path)
                .toLowerCase();

        if (name == '.nomedia') {
          containsNoMedia = true;
          break;
        }
      }
    }

    final bool isHiddenFolder =
        directoryIsHidden ||
            containsNoMedia ||
            parentIsHidden;

    if (isHiddenFolder) {
      _hiddenFolders.add(
        directory.path,
      );
    }

    /*
     * Second pass:
     * process media and recurse.
     */
    for (final FileSystemEntity entity
        in children) {
      try {
        if (entity is Directory) {
          await _scanDirectory(
            entity,
            depth: depth + 1,
            parentIsHidden: isHiddenFolder,
          );

          continue;
        }

        if (entity is! File) {
          continue;
        }

        final String fileName =
            _fileName(entity.path);

        final String extension =
            _extension(fileName);

        final bool isImage =
            _imageExtensions
                .contains(extension);

        final bool isVideo =
    _videoExtensions
        .contains(extension);

final bool isDocument =
    [
      'pdf',
      'doc',
      'docx',
    ].contains(extension);

if (!isImage &&
    !isVideo &&
    !isDocument) {
  continue;
}


        /*
         * We only add a file if it is actually inside
         * a hidden/.nomedia tree OR the file itself begins
         * with a dot.
         */
        final bool hiddenFile =
            fileName.startsWith('.');

        if (!isHiddenFolder &&
            !hiddenFile) {
          continue;
        }

        final MediaType mediaType =
    isVideo
        ? MediaType.video
        : isDocument
            ? MediaType.document
            : MediaType.image;

        final MediaFile media =
            MediaFile(
          asset: null,
          filePath: entity.path,
          fileName: fileName,
          mediaType: mediaType,
          source: 'Hidden Folder',
        );

        final bool duplicate =
            _hiddenMedia.any(
          (MediaFile existing) =>
              existing.filePath ==
              media.filePath,
        );

        if (duplicate) {
          continue;
        }

        _hiddenMedia.add(media);

        if (isImage) {
  _imageCount++;
} else if (isVideo) {
  _videoCount++;
} else if (isDocument) {
  _documentCount++;
}

        /*
         * Don't update Flutter UI on every single file.
         * The list will be displayed after the scan.
         */
      } catch (_) {
        // Ignore inaccessible files and continue scanning.
      }
    }
  }

  bool _isHiddenDirectory(
    Directory directory,
  ) {
    final String name =
        _fileName(directory.path);

    return name.startsWith('.');
  }

  bool _shouldSkipDirectory(
    String path,
  ) {
    final String normalized =
        path.toLowerCase();

    if (normalized ==
        '/storage/emulated/0/recova') {
      return true;
    }

    if (normalized.contains(
      '/android/data',
    )) {
      return true;
    }

    if (normalized.contains(
      '/android/obb',
    )) {
      return true;
    }

    return false;
  }

  static const Set<String>
      _imageExtensions = <String>{
    '.jpg',
    '.jpeg',
    '.png',
    '.webp',
    '.gif',
    '.bmp',
    '.heic',
    '.heif',
  };

  static const Set<String>
      _videoExtensions = <String>{
    '.mp4',
    '.mkv',
    '.avi',
    '.mov',
    '.3gp',
    '.m4v',
    '.webm',
    '.flv',
  };

  String _extension(String name) {
    final int index =
        name.lastIndexOf('.');

    if (index == -1) {
      return '';
    }

    return name
        .substring(index)
        .toLowerCase();
  }

  String _fileName(String path) {
    final String normalized =
        path.replaceAll('\\', '/');

    final int index =
        normalized.lastIndexOf('/');

    if (index == -1) {
      return normalized;
    }

    return normalized.substring(
      index + 1,
    );
  }

 List<MediaFile> get _filteredMedia {
  switch (_selectedFilter) {
    case 'Images':
      return _hiddenMedia
          .where(
            (MediaFile file) => file.isImage,
          )
          .toList();

    case 'Videos':
      return _hiddenMedia
          .where(
            (MediaFile file) => file.isVideo,
          )
          .toList();

    case 'Documents':
      return _hiddenMedia
          .where(
            (MediaFile file) => file.isDocument,
          )
          .toList();

    case 'All':
    default:
      return List<MediaFile>.from(
        _hiddenMedia,
      );
  }
}
 
 List<MediaFile> get _selectedFiles {
    return _hiddenMedia
        .where(
          (MediaFile file) =>
              file.selected,
        )
        .toList();
  }

  Future<void> _recoverSelected() async {
    if (_isRecovering) {
      return;
    }

    final List<MediaFile> selected =
        _selectedFiles;

    if (selected.isEmpty) {
      _showMessage(
        'Please select hidden media first.',
      );
      return;
    }

    final bool? confirmed =
        await showDialog<bool>(
      context: context,
      builder: (BuildContext context) {
        return AlertDialog(
          title: const Text(
            'Recover Hidden Media',
          ),
          content: Text(
            'Recover ${selected.length} selected '
            'hidden file${selected.length == 1 ? '' : 's'}?',
          ),
          actions: <Widget>[
            TextButton(
              onPressed: () =>
                  Navigator.of(context)
                      .pop(false),
              child: const Text('CANCEL'),
            ),
            FilledButton(
              onPressed: () =>
                  Navigator.of(context)
                      .pop(true),
              child: const Text('RECOVER'),
            ),
          ],
        );
      },
    );

    if (confirmed != true) {
      return;
    }

    setState(() {
      _isRecovering = true;
    });

    try {
      /*
       * ONLY selected hidden media is passed.
       */
      final RecoveryResult result =
          await _recovery.recoverFiles(
        selected,
      );

      if (!mounted) {
        return;
      }

      setState(() {
        _isRecovering = false;
      });

      await _showRecoveryResult(
        result,
      );
    } catch (e) {
      if (!mounted) {
        return;
      }

      setState(() {
        _isRecovering = false;
      });

      _showMessage(
        'Recovery failed: $e',
        isError: true,
      );
    }
  }

Future<void> _showRecoveryResult(
    RecoveryResult result,
  ) async {
    await showDialog<void>(
      context: context,
      builder: (BuildContext context) {
        return AlertDialog(
          title: const Text(
            'Recovery Complete',
          ),
          content: Text(
            '${result.recoveredFiles} file'
            '${result.recoveredFiles == 1 ? '' : 's'} recovered.\n\n'
            'Photos: ${result.photos}\n'
            'Videos: ${result.videos}\n'
            'Documents: ${result.documents}\n'
            'Failed: ${result.failedFiles}\n\n'
            'Saved to:\n'
            '/Recova/Recovered/',
          ),
          actions: <Widget>[
            FilledButton(
              onPressed: () =>
                  Navigator.of(context)
                      .pop(),
              child: const Text('OK'),
            ),
          ],
        );
      },
    );

    if (!mounted) {
      return;
    }

    if (result.recoveredFiles > 0) {
      setState(() {
        _hiddenMedia.removeWhere(
          (MediaFile file) =>
              file.selected,
        );

        _imageCount =
            _hiddenMedia
                .where(
                  (MediaFile file) =>
                      file.isImage,
                )
                .length;

        _documentCount =
    _hiddenMedia
        .where(
          (MediaFile file) =>
              file.isDocument,
        )
        .length;
      });
    }
  }

  void _selectAll() {
    setState(() {
      for (final MediaFile file
          in _hiddenMedia) {
        file.selected = true;
      }
    });
  }

  void _clearSelection() {
    setState(() {
      for (final MediaFile file
          in _hiddenMedia) {
        file.selected = false;
      }
    });
  }

  Widget _buildMediaCard(
    MediaFile media,
  ) {
    return GestureDetector(
      onTap: () {
        setState(() {
          media.selected =
              !media.selected;
        });
      },
      child: Stack(
        fit: StackFit.expand,
        children: <Widget>[
          ClipRRect(
            borderRadius:
                BorderRadius.circular(14),
            child: Image.file(
              File(media.filePath),
              fit: BoxFit.cover,
              errorBuilder: (
                BuildContext context,
                Object error,
                StackTrace? stack,
              ) {
                return Container(
                  color: Colors.grey.shade200,
                  child: Icon(
                    media.isVideo
                        ? Icons.video_library
                        : Icons.image,
                    size: 55,
                    color: Colors.grey,
                  ),
                );
              },
            ),
          ),
          if (media.isVideo)
            const Center(
              child: CircleAvatar(
                radius: 24,
                backgroundColor:
                    Colors.black54,
                child: Icon(
                  Icons.play_arrow,
                  color: Colors.white,
                  size: 30,
                ),
              ),
            ),
          Positioned(
            left: 0,
            right: 0,
            bottom: 0,
            child: Container(
              padding:
                  const EdgeInsets.all(7),
              color: Colors.black54,
              child: Text(
                media.fileName,
                maxLines: 1,
                overflow:
                    TextOverflow.ellipsis,
                style: const TextStyle(
                  color: Colors.white,
                  fontSize: 12,
                ),
              ),
            ),
          ),
          Positioned(
            top: 8,
            right: 8,
            child: Container(
              width: 28,
              height: 28,
              decoration: BoxDecoration(
                shape: BoxShape.circle,
                color: media.selected
                    ? Colors.blue
                    : Colors.white70,
                border: Border.all(
                  color: Colors.white,
                  width: 2,
                ),
              ),
              child: media.selected
                  ? const Icon(
                      Icons.check,
                      color: Colors.white,
                      size: 18,
                    )
                  : null,
            ),
          ),
        ],
      ),
    );
  }

  Widget _buildBody() {
    if (_isScanning) {
      return const Center(
        child: Column(
          mainAxisAlignment:
              MainAxisAlignment.center,
          children: <Widget>[
            CircularProgressIndicator(),
            SizedBox(height: 20),
            Text(
              'Scanning hidden folders...',
              style: TextStyle(
                fontSize: 18,
                fontWeight: FontWeight.bold,
              ),
            ),
            SizedBox(height: 8),
            Text(
              'Searching .nomedia and hidden directories',
              textAlign: TextAlign.center,
              style: TextStyle(
                color: Colors.grey,
              ),
            ),
          ],
        ),
      );
    }

    if (_hiddenMedia.isEmpty) {
      return RefreshIndicator(
        onRefresh: _scanHiddenMedia,
        child: ListView(
          physics:
              const AlwaysScrollableScrollPhysics(),
          children: const <Widget>[
            SizedBox(height: 170),
            Icon(
              Icons.visibility_off,
              size: 75,
              color: Colors.grey,
            ),
            SizedBox(height: 20),
            Center(
              child: Text(
                'No hidden media found',
                style: TextStyle(
                  fontSize: 20,
                  fontWeight: FontWeight.bold,
                ),
              ),
            ),
            SizedBox(height: 10),
            Padding(
              padding:
                  EdgeInsets.symmetric(
                horizontal: 35,
              ),
              child: Text(
                'The scan searches hidden folders '
                'and folders containing .nomedia.',
                textAlign: TextAlign.center,
                style: TextStyle(
                  color: Colors.grey,
                ),
              ),
            ),
          ],
        ),
      );
    }

    return Column(
      children: <Widget>[
        _buildSummary(),
        Expanded(
          child: GridView.builder(
            padding:
                const EdgeInsets.all(12),
            gridDelegate:
                const SliverGridDelegateWithFixedCrossAxisCount(
              crossAxisCount: 2,
              crossAxisSpacing: 10,
              mainAxisSpacing: 10,
              childAspectRatio: 0.90,
            ),
            itemCount:
                _hiddenMedia.length,
            itemBuilder: (
              BuildContext context,
              int index,
            ) {
              return _buildMediaCard(
                _hiddenMedia[index],
              );
            },
          ),
        ),
      ],
    );
  }

  Widget _buildSummary() {
    final int selected =
        _selectedFiles.length;

    return Container(
      margin:
          const EdgeInsets.all(16),
      padding:
          const EdgeInsets.all(20),
      decoration: BoxDecoration(
        gradient: const LinearGradient(
          colors: <Color>[
            Color(0xFF512DA8),
            Color(0xFF9C27B0),
          ],
        ),
        borderRadius:
            BorderRadius.circular(24),
      ),
      child: Column(
        children: <Widget>[
          const Icon(
            Icons.visibility_off,
            color: Colors.white,
            size: 48,
          ),
          const SizedBox(height: 8),
          const Text(
            'Hidden Media',
            style: TextStyle(
              color: Colors.white,
              fontSize: 25,
              fontWeight: FontWeight.bold,
            ),
          ),
          const SizedBox(height: 6),
          const Text(
            'Actual hidden/.nomedia media only',
            style: TextStyle(
              color: Colors.white70,
            ),
          ),
          const SizedBox(height: 18),
          Row(
            mainAxisAlignment:
                MainAxisAlignment.spaceEvenly,
            children: <Widget>[
              _summaryItem(
                Icons.folder_off,
                'Folders',
                _hiddenFolders.length,
              ),
              _summaryItem(
                Icons.image,
                'Images',
                _imageCount,
              ),
              _summaryItem(
                Icons.video_library,
                'Videos',
                _videoCount,
              ),
            ],
          ),
          const SizedBox(height: 15),
          Text(
            '$selected selected',
            style: const TextStyle(
              color: Colors.white,
              fontWeight: FontWeight.bold,
            ),
          ),
        ],
      ),
    );
  }

  Widget _summaryItem(
    IconData icon,
    String label,
    int value,
  ) {
    return Column(
      children: <Widget>[
        Icon(
          icon,
          color: Colors.white,
          size: 28,
        ),
        const SizedBox(height: 4),
        Text(
          '$value',
          style: const TextStyle(
            color: Colors.white,
            fontSize: 21,
            fontWeight: FontWeight.bold,
          ),
        ),
        Text(
          label,
          style: const TextStyle(
            color: Colors.white70,
          ),
        ),
      ],
    );
  }

  Widget _bottomButtons() {
    return SafeArea(
      child: Padding(
        padding:
            const EdgeInsets.fromLTRB(
          16,
          5,
          16,
          12,
        ),
        child: Column(
          children: <Widget>[
            Row(
              children: <Widget>[
                Expanded(
                  child: OutlinedButton.icon(
                    onPressed: _selectAll,
                    icon: const Icon(
                      Icons.select_all,
                    ),
                    label:
                        const Text('Select All'),
                  ),
                ),
                const SizedBox(width: 10),
                Expanded(
                  child: OutlinedButton.icon(
                    onPressed:
                        _clearSelection,
                    icon: const Icon(
                      Icons.clear_all,
                    ),
                    label:
                        const Text('Clear'),
                  ),
                ),
              ],
            ),
            const SizedBox(height: 8),
            SizedBox(
              width: double.infinity,
              child: FilledButton.icon(
                onPressed:
                    _isRecovering
                        ? null
                        : _recoverSelected,
                icon: _isRecovering
                    ? const SizedBox(
                        width: 20,
                        height: 20,
                        child:
                            CircularProgressIndicator(
                          strokeWidth: 2,
                          color: Colors.white,
                        ),
                      )
                    : const Icon(
                        Icons.restore,
                      ),
                label: Text(
                  _isRecovering
                      ? 'Recovering...'
                      : 'Recover Selected',
                ),
                style: FilledButton.styleFrom(
                  minimumSize:
                      const Size(
                    double.infinity,
                    52,
                  ),
                ),
              ),
            ),
          ],
        ),
      ),
    );
  }

  void _showStorageMessage() {
    _showMessage(
      'Storage access is required to scan hidden folders. '
      'Enable full storage access for Recova and scan again.',
      isError: true,
    );
  }

  void _showMessage(
    String message, {
    bool isError = false,
  }) {
    ScaffoldMessenger.of(context)
        .showSnackBar(
      SnackBar(
        content: Text(message),
        backgroundColor:
            isError ? Colors.red : null,
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text(
          'Hidden Media Finder',
        ),
        actions: <Widget>[
          IconButton(
            onPressed:
                _isScanning
                    ? null
                    : _scanHiddenMedia,
            icon: const Icon(
              Icons.refresh,
            ),
          ),
        ],
      ),
      body: _buildBody(),
      bottomNavigationBar:
          _hiddenMedia.isEmpty ||
                  _isScanning
              ? null
              : _bottomButtons(),
    );
  }
}
